/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user data and project ownership,
 * with role-based access control for project documents. It prioritizes security and data access
 * based on user roles and project affiliations.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles; accessible only by the user themselves.
 * - /companies/{companyId}: Stores company data, write access needs to be restricted to admins.
 * - /projects/{projectId}: Stores project data; write access needs to be restricted to project owners.
 * - /claims/{claimId}: Stores claim data; write access needs to be restricted to claim submitters or project owners.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks related to projects; write access needs to be restricted to project owners.
 * - /projects/{projectId}/documents/{documentId}: Stores project documents; access controlled by document-specific roles.
 *
 * Key Security Decisions:
 * - Users can only read and write their own data in /users/{userId}.
 * - Listing of users is disallowed.
 * - Project data can be created by project owners and updated by authorized users.
 * - Access to project documents is role-based, determined by the 'accessRole' field in the document.
 * - Claims are stored in a top-level collection for efficient querying.
 *
 * Denormalization for Authorization:
 * - The 'accessRole' field is denormalized into the Document entity to enable role-based access control without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile.
     * @allow (get, update, delete) User with UID 'user123' can read and update their profile.
     * @deny (get, update, delete) User with UID 'user456' cannot access 'user123' profile.
     * @deny (list) No one can list users.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to company data.
     * @path /companies/{companyId}
     * @allow (create) Admins can create company profiles (TODO: Implement admin role check).
     * @allow (get, update, delete) Admins can read and update company profiles (TODO: Implement admin role check).
     * @deny (create, update, delete) Non-admins cannot modify company profiles.
     * @deny (list) No one can list companies.
     * @principle Restricts company data management to administrators.
     */
    match /companies/{companyId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to project data.
     * @path /projects/{projectId}
     * @allow (get, list) Anyone can read project data.
     * @allow (create) User with UID 'user123' can create a project with themselves as the owner.
     * @allow (update, delete) User with UID 'user123' can update/delete project if they are the owner.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete project if they are not the owner.
     * @principle Public read, owner-only writes for projects.
     */
    match /projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.owner == request.auth.uid;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    /**
     * @description Controls access to claim data.
     * @path /claims/{claimId}
     * @allow (get, list) Anyone can read claim data.
     * @allow (create) User with UID 'user123' can create a claim.
     * @allow (update, delete) User with UID 'user123' can update/delete claim if they are the owner.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete claim if they are not the owner.
     * @principle Public read, owner-only writes for claims.
     */
    match /claims/{claimId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.owner == request.auth.uid;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    /**
     * @description Controls access to tasks within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get, list) Anyone can read task data within a project.
     * @allow (create) User with UID 'user123' can create a task within a project.
     * @allow (update, delete) User with UID 'user123' can update/delete task if they are the owner.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete task if they are not the owner.
     * @principle Public read, owner-only writes for tasks within projects.
     */
    match /projects/{projectId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isProjectOwner(projectId) {
        return get(/databases/$(database)/documents/projects/$(projectId)).data.owner == request.auth.uid;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isProjectOwner(projectId);
      allow delete: if isProjectOwner(projectId);
    }

    /**
     * @description Controls access to documents within a project based on roles.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get, list) Anyone can read document data within a project.
     * @allow (create) User with UID 'user123' can create a document within a project.
     * @allow (update, delete) User with UID 'user123' can update/delete document if they are the owner.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete document if they are not the owner.
     * @principle Role-based access control for documents within projects.
     */
    match /projects/{projectId}/documents/{documentId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isProjectOwner(projectId) {
        return get(/databases/$(database)/documents/projects/$(projectId)).data.owner == request.auth.uid;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isProjectOwner(projectId);
      allow delete: if isProjectOwner(projectId);
    }
  }
}