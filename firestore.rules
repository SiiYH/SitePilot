/**
 * @file Firestore Security Rules for SiteFlow Application
 *
 * @description This ruleset enforces a role-based access control model for a construction project management application.
 * All data is organized under top-level collections for users, projects, tasks, and documents. User data is stored
 * under `/users/{userId}`, project data under `/projects/{projectId}`, tasks under `/projects/{projectId}/tasks/{taskId}`,
 * and documents under `/projects/{projectId}/documents/{documentId}`.
 *
 * @core_philosophy Role-based access control with denormalization for simpler rules.
 *
 * @data_structure
 *   - `/users/{userId}`: Stores user profiles, accessible only to the user themselves.
 *   - `/projects/{projectId}`: Stores project information. Access control is not explicitly defined in the IR, defaulting to owner-only for writes and public reads.
 *   - `/projects/{projectId}/tasks/{taskId}`: Stores tasks associated with projects. Access control is not explicitly defined in the IR, defaulting to owner-only for writes and public reads.
 *   - `/projects/{projectId}/documents/{documentId}`: Stores documents associated with projects. Access control is not explicitly defined in the IR, defaulting to owner-only for writes and public reads.
 *
 * @key_security_decisions
 *   - Users can only access their own user documents.
 *   - Listing of users is disallowed for privacy.
 *   - For Projects, Tasks, and Documents, the rules default to public read access but require owner-only access for any modifications.
 *   - The rules validate the `id` field on `create` operations to ensure consistency with the document path.
 *   - The rules enforce immutability of the `id` field on `update` operations to maintain relational integrity.
 *
 * @denormalization_for_authorization No explicit denormalization instructions given. Assuming ownership will be determined by matching IDs.
 * @structural_segregation No explicit structural segregation needed in the given data model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-only access to their own profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile at /users/user123 with matching id.
     * @allow (get) User with UID 'user123' can read their own profile at /users/user123.
     * @allow (update) User with UID 'user123' can update their own profile at /users/user123.
     * @allow (delete) User with UID 'user123' can delete their own profile at /users/user123.
     * @deny (create) User with UID 'user456' cannot create a profile for user 'user123' at /users/user123.
     * @deny (get) User with UID 'user456' cannot read user 'user123' profile at /users/user123.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Disallowing listing of all users for privacy.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to project data, but restricts modifications to the project owner.
     * @path /projects/{projectId}
     * @allow (get) Any user can read project data at /projects/project123.
     * @allow (list) Any user can list projects.
     * @allow (create) User with UID 'user123' can create a project at /projects/project123 if request.resource.data.id == 'project123'.
     * @allow (update) User with UID 'user123' can update project 'project123' if request.resource.data.id == resource.data.id.
     * @allow (delete) User with UID 'user123' can delete project 'project123'.
     * @deny (create) User with UID 'user456' cannot create a project at /projects/project123.
     * @principle Public read with owner-only writes; enforces document ownership for writes.
     */
    match /projects/{projectId} {
        allow get: if true;
        allow list: if true;

        // Assuming 'id' is a property of project and will be used as owner.
        allow create: if isSignedIn() && request.resource.data.id == projectId;
        allow update: if isSignedIn() && resource != null && request.resource.data.id == resource.data.id;
        allow delete: if isSignedIn() && resource != null && resource.data.id == projectId;
    }

    /**
     * @description Allows public read access to task data, but restricts modifications to the task owner.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get) Any user can read task data at /projects/project123/tasks/task456.
     * @allow (list) Any user can list tasks within a project.
     * @allow (create) User with UID 'user123' can create a task at /projects/project123/tasks/task456 if request.resource.data.id == 'task456'.
     * @allow (update) User with UID 'user123' can update task 'task456' if request.resource.data.id == resource.data.id.
     * @allow (delete) User with UID 'user123' can delete task 'task456'.
     * @deny (create) User with UID 'user456' cannot create a task at /projects/project123/tasks/task456.
     * @principle Public read with owner-only writes; enforces document ownership for writes.
     */
    match /projects/{projectId}/tasks/{taskId} {
        allow get: if true;
        allow list: if true;

        // Assuming 'id' is a property of task and will be used as owner.
        allow create: if isSignedIn() && request.resource.data.id == taskId;
        allow update: if isSignedIn() && resource != null && request.resource.data.id == resource.data.id;
        allow delete: if isSignedIn() && resource != null && resource.data.id == taskId;
    }

    /**
     * @description Allows public read access to document data, but restricts modifications to the document owner.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get) Any user can read document data at /projects/project123/documents/document456.
     * @allow (list) Any user can list documents within a project.
     * @allow (create) User with UID 'user123' can create a document at /projects/project123/documents/document456 if request.resource.data.id == 'document456'.
     * @allow (update) User with UID 'user123' can update document 'document456' if request.resource.data.id == resource.data.id.
     * @allow (delete) User with UID 'user123' can delete document 'document456'.
     * @deny (create) User with UID 'user456' cannot create a document at /projects/project123/documents/document456.
     * @principle Public read with owner-only writes; enforces document ownership for writes.
     */
    match /projects/{projectId}/documents/{documentId} {
        allow get: if true;
        allow list: if true;

        // Assuming 'id' is a property of document and will be used as owner.
        allow create: if isSignedIn() && request.resource.data.id == documentId;
        allow update: if isSignedIn() && resource != null && request.resource.data.id == resource.data.id;
        allow delete: if isSignedIn() && resource != null && resource.data.id == documentId;
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}