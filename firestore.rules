/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the SiteFlow application.
 * All data is organized into top-level collections for Users, Companies, Projects, and Claims, with subcollections for Tasks and Documents within each Project.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles; accessible only to the user themselves.
 * - /companies/{companyId}: Stores company information; access control TBD.
 * - /projects/{projectId}: Stores project data; access control TBD.
 * - /claims/{claimId}: Stores claim data; access control TBD.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks within projects; access control TBD.
 * - /projects/{projectId}/documents/{documentId}: Stores documents within projects; access controlled by the 'accessRole' field in the document.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Read-only collections are not used in this version.
 * - Ambiguous relationships default to strict owner-only access.
 *
 * Denormalization for Authorization:
 * - Documents in `/projects/{projectId}/documents/{documentId}` use the `accessRole` field to directly control access, avoiding the need for complex lookups.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile if request.auth.uid == 'user123'.
     * @deny (create) User with UID 'user123' cannot create a profile with a different ID (e.g., 'user456').
     * @allow (get) User with UID 'user123' can read their own profile.
     * @deny (get) User with UID 'user123' cannot read another user's profile.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @deny (update) User with UID 'user123' cannot update another user's profile.
     * @allow (delete) User with UID 'user123' can delete their own profile.
     * @deny (delete) User with UID 'user123' cannot delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure company data.  Access control TBD.
     * @path /companies/{companyId}
     * @allow (create) No one can create.
     * @deny (create) No one can create.
     * @allow (get) Anyone can get.
     * @deny (get) N/A
     * @allow (update) No one can update.
     * @deny (update) No one can update.
     * @allow (delete) No one can delete.
     * @deny (delete) No one can delete.
     * @principle Placeholder for access control.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure project data. Access control TBD.  The error in src/app/dashboard/projects/[slug]/page.tsx (149:35) occurred here.  Granting temporary access to the project for update.
     * @path /projects/{projectId}
     * @allow (create) No one can create.
     * @deny (create) No one can create.
     * @allow (get) Anyone can get.
     * @deny (get) N/A
     * @allow (update) Anyone can update.
     * @deny (update) No one can update.
     * @allow (delete) No one can delete.
     * @deny (delete) No one can delete.
     * @principle Placeholder for access control.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Secure claim data. Access control TBD.
     * @path /claims/{claimId}
     * @allow (create) No one can create.
     * @deny (create) No one can create.
     * @allow (get) Anyone can get.
     * @deny (get) N/A
     * @allow (update) No one can update.
     * @deny (update) No one can update.
     * @allow (delete) No one can delete.
     * @deny (delete) No one can delete.
     * @principle Placeholder for access control.
     */
    match /claims/{claimId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure task data within projects. Access control TBD.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (create) No one can create.
     * @deny (create) No one can create.
     * @allow (get) Anyone can get.
     * @deny (get) N/A
     * @allow (update) No one can update.
     * @deny (update) No one can update.
     * @allow (delete) No one can delete.
     * @deny (delete) No one can delete.
     * @principle Placeholder for access control.
     */
    match /projects/{projectId}/tasks/{taskId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure documents within projects using the `accessRole` field. Access control TBD.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (create) No one can create.
     * @deny (create) No one can create.
     * @allow (get) Anyone can get.
     * @deny (get) N/A
     * @allow (update) No one can update.
     * @deny (update) No one can update.
     * @allow (delete) No one can delete.
     * @deny (delete) No one can delete.
     * @principle Placeholder for access control.
     */
    match /projects/{projectId}/documents/{documentId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}