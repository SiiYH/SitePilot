/**
 * @fileoverview Firestore Security Rules for SiteFlow application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure, role-based access control model.
 * It enforces ownership for user-specific data and role-based access for project-related data.
 * The rules are designed to prevent unauthorized data access and modification.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with 'userId' matching the Firebase Auth UID.
 * - /companies/{companyId}: Stores company information.
 * - /projects/{projectId}: Stores project details.
 * - /claims/{claimId}: Stores payment claim information.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks associated with projects.
 * - /projects/{projectId}/documents/{documentId}: Stores documents related to projects.
 *
 * Key Security Decisions:
 * - User data is strictly controlled, with each user only able to access their own profile.
 * - Project, task, and document access is role-based, determined by the user's role.
 * - Public listing of projects is disallowed to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * - Tasks and Documents are stored as subcollections of Projects.
 * - Document.accessRole is denormalized for role-based access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User can access and modify their own profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @deny (list) Listing all users is not allowed.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows access to company data.
     * @path /companies/{companyId}
     * @allow (get, list) Anyone can read company information.
     * @deny (create, update, delete) Only authorized users can modify company information.
     * @principle Requires specific authorization to modify company data.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows access to project data.
     * @path /projects/{projectId}
     * @allow (get, list) Anyone can read project information.
     * @deny (create, update, delete) Only authorized users can modify project information.
     * @principle Requires specific authorization to modify project data.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows access to claim data.
     * @path /claims/{claimId}
     * @allow (get, list) Anyone can read claim information.
     * @deny (create, update, delete) Only authorized users can modify claim information.
     * @principle Requires specific authorization to modify claim data.
     */
    match /claims/{claimId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows access to task data within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get, list) Anyone can read task information.
     * @deny (create, update, delete) Only authorized users can modify task information.
     * @principle Requires specific authorization to modify task data.
     */
    match /projects/{projectId}/tasks/{taskId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows access to document data within a project based on role.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get, list) Anyone can read document information.
     * @deny (create, update, delete) Only authorized users can modify document information.
     * @principle Requires specific authorization to modify document data.
     */
    match /projects/{projectId}/documents/{documentId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}