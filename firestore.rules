rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user documents.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their own document.
     * @allow (get, update, delete) User with matching UID can read, update, and delete their own document.
     * @deny (create) User cannot create a document with a different UID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's document.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == request.auth.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to company documents.
     * @path /companies/{companyId}
     * @allow (get, list, create, update, delete) All authenticated users can read, list, create, update, and delete company documents.
     * @principle Allows access to company documents for all authenticated users.
     */
    match /companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Manages access to project documents.
     * @path /projects/{projectId}
     * @allow (get, list, create, update, delete) All authenticated users can read, list, create, update, and delete project documents.
     * @principle Allows access to project documents for all authenticated users.
     */
    match /projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Manages access to claim documents.
     * @path /claims/{claimId}
     * @allow (get, list, create, update, delete) All authenticated users can read, list, create, update, and delete claim documents.
     * @principle Allows access to claim documents for all authenticated users.
     */
    match /claims/{claimId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Manages access to task documents within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get, list, create, update, delete) All authenticated users can read, list, create, update, and delete task documents.
     * @principle Allows access to task documents for all authenticated users.
     */
    match /projects/{projectId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Manages access to document documents within a project, based on role.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get, list, create, update, delete) All authenticated users can read, list, create, update, and delete document documents.
     * @principle Allows access to document documents for all authenticated users.
     */
    match /projects/{projectId}/documents/{documentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list, create, update, delete: if isSignedIn();
    }
  }
}