/**
 * @fileoverview Firestore Security Rules for SiteFlow application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and role-based access control for project-related data. It prioritizes
 * security by default, explicitly denying access unless specifically allowed.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, with 'userId' matching the
 *   Firebase Authentication UID.
 * - /projects/{projectId}: Stores project information.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks associated with projects.
 * - /projects/{projectId}/documents/{documentId}: Stores project documents.
 *
 * Key Security Decisions:
 * - User profiles are strictly owned by the authenticated user.
 * - Listing of user profiles is disallowed to prevent information disclosure.
 * - Project documents enforce role-based access control via the 'accessRole' field.
 * - Data validation is minimal in this prototype, focusing on ownership and
 *   relational integrity checks.
 *
 * Denormalization for Authorization:
 * - The `User` document stores the user's `role` for simplified access control
 *   when accessing project documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2' can create their own profile.
     * @allow (get) User with UID 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2' can get their own profile.
     * @allow (update) User with UID 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2' can update their own profile.
     * @allow (delete) User with UID 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2' can delete their own profile.
     * @deny (create) User with UID 'anotherUserId' cannot create a profile for 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2'.
     * @deny (get) User with UID 'anotherUserId' cannot get profile of 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2'.
     * @deny (update) User with UID 'anotherUserId' cannot update profile of 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2'.
     * @deny (delete) User with UID 'anotherUserId' cannot delete profile of 'RO0L7yKqDqRnOTVx4Rk4v84tmfp2'.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to project data.
     * @path /projects/{projectId}
     * @allow (get) Any signed-in user can read project data.
     * @allow (list) Any signed-in user can list project data.
     * @allow (create) Any signed-in user can create project data.
     * @allow (update) Any signed-in user can update project data if they are the owner.
     * @allow (delete) Any signed-in user can delete project data if they are the owner.
     * @deny (create) Unauthorized user cannot create project data.
     * @deny (update) Unauthorized user cannot update project data.
     * @deny (delete) Unauthorized user cannot delete project data.
     * @principle Public read, owner-only writes for projects.
     */
    match /projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();  // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to task data within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get) Any signed-in user can read task data within a project.
     * @allow (list) Any signed-in user can list task data within a project.
     * @allow (create) Any signed-in user can create task data within a project.
     * @allow (update) Any signed-in user can update task data if they are the owner.
     * @allow (delete) Any signed-in user can delete task data if they are the owner.
     * @deny (create) Unauthorized user cannot create task data within a project.
     * @deny (update) Unauthorized user cannot update task data within a project.
     * @deny (delete) Unauthorized user cannot delete task data within a project.
     * @principle Public read, owner-only writes for tasks within a project.
     */
    match /projects/{projectId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();  // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to document data within a project based on the 'accessRole'.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get) Any signed-in user can read document data within a project.
     * @allow (list) Any signed-in user can list document data within a project.
     * @allow (create) Any signed-in user can create document data within a project.
     * @allow (update) Any signed-in user can update document data if they have the required role.
     * @allow (delete) Any signed-in user can delete document data if they have the required role.
     * @deny (create) Unauthorized user cannot create document data within a project.
     * @deny (update) Unauthorized user without the required role cannot update document data within a project.
     * @deny (delete) Unauthorized user without the required role cannot delete document data within a project.
     * @principle Role-based access control for project documents.
     */
    match /projects/{projectId}/documents/{documentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // TODO: Implement role-based access control based on resource.data.accessRole and user.role.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // TODO: Implement role-based access validation based on resource.data.accessRole and user.role.
      allow delete: if isSignedIn(); // TODO: Implement role-based access validation based on resource.data.accessRole and user.role.
    }
  }
}