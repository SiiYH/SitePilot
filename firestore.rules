/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user data and role-based access control for project-related data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /companies/{companyId}: Stores company data, with open read access and restricted write access.
 * - /projects/{projectId}: Stores project data, with owner-only write access.
 * - /claims/{claimId}: Stores payment claims, with owner-only write access.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks within projects, with project-level access control.
 * - /projects/{projectId}/documents/{documentId}: Stores documents within projects, with role-based access control.
 *
 * Key Security Decisions:
 * - Users can only access their own user documents.
 * - Projects, claims, tasks and documents have owner-only or role-based write access.
 * - Listing users is disallowed for privacy.
 * - Read access to companies are public.
 *
 * Denormalization for Authorization:
 * - Project documents do not contain an ownership field.
 * - Task documents do not contain an ownership field.
 * - Document documents do not contain an ownership field.
 *
 * Structural Segregation:
 * - Private user data is stored under /users/{userId}, separate from public project collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user document.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create /users/user123
     * @allow (get) User with ID 'user123' can get /users/user123
     * @allow (update) User with ID 'user123' can update /users/user123
     * @allow (delete) User with ID 'user123' can delete /users/user123
     * @deny (create) User with ID 'user456' cannot create /users/user123
     * @deny (get) User with ID 'user456' cannot get /users/user123
     * @deny (update) User with ID 'user456' cannot update /users/user123
     * @deny (delete) User with ID 'user456' cannot delete /users/user123
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read company data, but restricts writes.
     * @path /companies/{companyId}
     * @allow (get) Any user can read company data.
     * @allow (list) Any user can list company data.
     * @deny (create) No one can create company data via client.
     * @deny (update) No one can update company data via client.
     * @deny (delete) No one can delete company data via client.
     * @principle Allows public read access but restricts writes for security.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read access to all projects, but restricts writes to project owners.
     * @path /projects/{projectId}
     * @allow (get) Any user can read project data.
     * @allow (list) Any user can list project data.
     * @deny (create) No one can create project data via client. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) No one can update project data without being the owner.
     * @deny (delete) No one can delete project data without being the owner.
     * @principle Allows public read access but restricts writes for security.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows read access to all claims, but restricts writes to claim owners.
     * @path /claims/{claimId}
     * @allow (get) Any user can read claim data.
     * @allow (list) Any user can list claim data.
     * @deny (create) No one can create claim data via client. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) No one can update claim data without being the owner.
     * @deny (delete) No one can delete claim data without being the owner.
     * @principle Allows public read access but restricts writes for security.
     */
    match /claims/{claimId} {
      allow get, list: if true;
      allow create: if false;  // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows project members to read and write tasks within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get) Any user can read task data.
     * @allow (list) Any user can list task data.
     * @deny (create) No one can create task data via client. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) No one can update task data without being the owner.
     * @deny (delete) No one can delete task data without being the owner.
     * @principle Allows public read access but restricts writes for security.
     */
    match /projects/{projectId}/tasks/{taskId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows users with the specified role to read and write documents within a project.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get) Any user can read document data.
     * @allow (list) Any user can list document data.
     * @deny (create) No one can create document data via client. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) No one can update document data without being the owner.
     * @deny (delete) No one can delete document data without being the owner.
     * @principle Allows public read access but restricts writes for security.
     */
    match /projects/{projectId}/documents/{documentId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }

  // Helper function to determine if the current user is the owner of the resource.
  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  // Helper function to determine if the current user is the owner of the resource and it exists.
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}