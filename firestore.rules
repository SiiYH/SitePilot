/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and applies role-based access control for project documents.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data. Access is restricted to the user themselves.
 * - /companies/{companyId}: Stores company data. No specific access controls are defined in this prototype.
 * - /projects/{projectId}: Stores project data. No specific access controls are defined in this prototype.
 * - /claims/{claimId}: Stores claim data. No specific access controls are defined in this prototype.
 * - /projects/{projectId}/tasks/{taskId}: Stores task data. No specific access controls are defined in this prototype.
 * - /projects/{projectId}/documents/{documentId}: Stores project-related documents with role-based access control.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listing of users is disallowed.
 * - No default security posture is assumed; all rules are explicitly defined.
 *
 * Denormalization for Authorization:
 *   - User roles are denormalized into the User document, avoiding the need for separate role lookups.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (update) User with UID '23OyhhrluHOD4NCc92qdwA2Knve2' can update their own profile.
     * @deny (update) User with UID 'otherUserId' cannot update the profile of '23OyhhrluHOD4NCc92qdwA2Knve2'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Helper function to check if the request is authenticated
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the request is made by the owner of the user document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is the owner and the document exists
      function isExistingOwner(userId) {
          return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
      }

      // Allow reading the user's own document
      allow get: if isOwner(userId);
      // Prevent listing all users
      allow list: if false;
      // Allow creating a user document if the UID matches the document ID
      allow create: if isOwner(userId) && request.auth.uid == userId;
      // Allow updating a user document if the user is the owner and the document exists
      allow update: if isExistingOwner(userId);
      // Allow deleting a user document if the user is the owner and the document exists
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to company data.
     * @path /companies/{companyId}
     * @allow (get) Allow anyone to read company data.
     * @deny (create) Prevent anyone from creating company data.
     * @principle Requires authentication for all operations.
     */
    match /companies/{companyId} {
      // Allow anyone to read company data
      allow get, list: if true;
      // Prevent anyone from creating, updating, or deleting company data
      allow create, update, delete: if false; // TODO: Add proper roles and authorization to the write requests.
    }

    /**
     * @description Controls access to project data.
     * @path /projects/{projectId}
     * @allow (get) Allow anyone to read project data.
     * @deny (create) Prevent anyone from creating project data.
     * @principle Requires authentication for all operations.
     */
    match /projects/{projectId} {
      // Allow anyone to read project data
      allow get, list: if true;
      // Prevent anyone from creating, updating, or deleting project data
      allow create, update, delete: if false;  // TODO: Add proper roles and authorization to the write requests.
    }

    /**
     * @description Controls access to claim data.
     * @path /claims/{claimId}
     * @allow (get) Allow anyone to read claim data.
     * @deny (create) Prevent anyone from creating claim data.
     * @principle Requires authentication for all operations.
     */
    match /claims/{claimId} {
      // Allow anyone to read claim data
      allow get, list: if true;
      // Prevent anyone from creating, updating, or deleting claim data
      allow create, update, delete: if false;  // TODO: Add proper roles and authorization to the write requests.
    }

    /**
     * @description Controls access to task data within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get) Allow anyone to read task data.
     * @deny (create) Prevent anyone from creating task data.
     * @principle Requires authentication for all operations.
     */
    match /projects/{projectId}/tasks/{taskId} {
      // Allow anyone to read task data
      allow get, list: if true;
      // Prevent anyone from creating, updating, or deleting task data
      allow create, update, delete: if false;  // TODO: Add proper roles and authorization to the write requests.
    }

    /**
     * @description Controls access to document data within a project.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get) Allow anyone to read document data.
     * @deny (create) Prevent anyone from creating document data.
     * @principle Requires authentication for all operations.
     */
    match /projects/{projectId}/documents/{documentId} {
      // Allow anyone to read document data
      allow get, list: if true;
      // Prevent anyone from creating, updating, or deleting document data
      allow create, update, delete: if false;  // TODO: Add proper roles and authorization to the write requests.
    }
  }
}