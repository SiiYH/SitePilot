rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Helper Functions ===
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }
    
    function getUserCompany() {
      return getUserData().companyId;
    }
    
    function isEngineer() {
      return getUserRole() == 'engineer';
    }
    
    function isAdminOrDirector() {
      let role = getUserRole();
      return role == 'admin' || role == 'director';
    }
    
    function isDirector() {
      return getUserRole() == 'director';
    }
    
    function isSuperSystemAdmin() {
      let role = getUserRole();
      return role == 'system super admin';
    }
    
    function isSameCompany() {
      return resource.data.companyId == getUserCompany();
    }
    
    function isCreatingSameCompany() {
      return request.resource.data.companyId == getUserCompany();
    }
    
    function isAssignedToProject() {
      return resource.data.assignedEngineers.hasAny([request.auth.uid]);
    }
    
    function canAccessProject() {
      return isSuperSystemAdmin() || 
             isAdminOrDirector() || 
             isAssignedToProject();
    }
    
    function isCompanyActivatedByLicense(uid, licenseId) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid));
      let companyDoc = userDoc != null && userDoc.data.companyId != null
        ? get(/databases/$(database)/documents/companies/$(userDoc.data.companyId))
        : null;

      return userDoc != null &&
             companyDoc != null &&
             isAdminOrDirector() &&
             companyDoc.data.licenseKey == licenseId &&
             companyDoc.data.activated == true;
    }
    
    function isClaimOwner(claimData) {
      return isSignedIn() && request.auth.uid == claimData.submittedBy;
    }

    // === User Rules ===
    match /users/{userId} {
      // Individual document read
      allow get: if isSignedIn() && (
        isOwner(userId) || 
        isAdminOrDirector() || 
        isSuperSystemAdmin()
      );
      
      // List all users in collection
      allow list: if isSignedIn() && (
        isAdminOrDirector() || 
        isSuperSystemAdmin() ||
        isEngineer()
      );
      
      // Allow new users to create their own profile during registration
      allow create: if true;
      
      allow update, delete: if isSignedIn() && (
        isOwner(userId) || 
        (isAdminOrDirector() && isSameCompany()) ||
        isSuperSystemAdmin()
      );
    }

    // === License Rules ===
    match /licenses/{licenseId} {
      allow read: if isSignedIn() && (
        isSuperSystemAdmin() ||
        isCompanyActivatedByLicense(request.auth.uid, licenseId)
      );

      allow write: if isSignedIn() && isSuperSystemAdmin();
    }

    // === Company Rules ===
    match /companies/{companyId} {
      // Individual company read
      allow get: if isSignedIn() && (
        getUserCompany() == companyId ||
        isAdminOrDirector() ||
        isSuperSystemAdmin()
      );
      
      // List all companies
      allow list: if isSignedIn() && (
        isAdminOrDirector() || 
        isSuperSystemAdmin()
      );
      
      allow create: if isSignedIn() && (
        isAdminOrDirector() || 
        isSuperSystemAdmin()
      );
      
      allow update, delete: if isSignedIn() && (
        (isAdminOrDirector() && getUserCompany() == companyId) ||
        isSuperSystemAdmin()
      );
    }

    // === Project Rules ===
    match /projects/{projectId} {
      // Individual project read
      allow get: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && (isAdminOrDirector() || isAssignedToProject()))
      );
      
      // List all projects - only users with proper roles
      allow list: if isSignedIn() && (
        isSuperSystemAdmin() ||
        isAdminOrDirector() ||
        isEngineer()
      );
      
      allow create: if isSignedIn() && (
        isCreatingSameCompany() && 
        (isAdminOrDirector() || isSuperSystemAdmin())
      );
      
      allow update: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && isAdminOrDirector()) ||
        resource.data.createdBy == request.auth.uid
      );
      
      allow delete: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && isAdminOrDirector()) ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // === Claims Rules ===
    match /claims/{claimId} {
      // Individual claim read
      allow get: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && (resource.data.submittedBy == request.auth.uid || isDirector()))
      );
      
      // List all claims - filter by role
      allow list: if isSignedIn() && (
        isSuperSystemAdmin() ||
        isAdminOrDirector() ||
        isEngineer()
      );
      
      allow create: if isSignedIn() && 
                       isCreatingSameCompany() &&
                       request.resource.data.submittedBy == request.auth.uid;
      
      allow update: if isSignedIn() && 
                       isSameCompany() &&
                       (resource.data.submittedBy == request.auth.uid || isDirector());
      
      // Fixed: Only owner or director can delete claims
      allow delete: if isSignedIn() && 
                       isSameCompany() &&
                       (resource.data.submittedBy == request.auth.uid || isDirector());
    }

    // === Task Rules ===
    match /projects/{projectId}/tasks/{taskId} {

      function getProject() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function getUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }

      function isAdminOrDirector() {
        let role = getUserRole();
        return role == 'admin' || role == 'director';
      }

      function isEngineer() {
        return getUserRole() == 'engineer';
      }

      function canAccessProject() {
        let project = getProject();
        return project.companyId == getUserCompany() && (
          isAdminOrDirector() ||
          project.assignedEngineers.hasAny([request.auth.uid])
        );
      }

      // Read access: all users assigned to the project (including engineers)
      allow get, list: if isSignedIn(); 
      // && canAccessProject();

      // Create access: admin/director or engineer assigned to the project
      allow create: if isSignedIn() && canAccessProject();

      // Update/Delete access: only admin or director
      allow update, delete: if isSignedIn() && isAdminOrDirector();
    }

    // === Document Rules ===
    match /projects/{projectId}/documents/{documentId} {
      function getProject() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }
      
      function canAccessParentProject() {
        let project = getProject();
        return project.companyId == getUserCompany() && (
          isAdminOrDirector() ||
          project.assignedEngineers.hasAny([request.auth.uid])
        );
      }
      
      allow get, list: if isSignedIn() && (
        isSuperSystemAdmin() ||
        canAccessParentProject()
      );
      
      allow create: if isSignedIn() && (
        isSuperSystemAdmin() ||
        canAccessParentProject()
      );
      
      allow update, delete: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (canAccessParentProject() && isAdminOrDirector())
      );
    }
  }
}