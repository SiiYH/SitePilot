/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the SiteFlow application.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
 * @description Manages user profile data.
 * @path /users/{userId}
 * @allow (get) User can read their own profile OR admin/director can read users from same company.
 * @allow (list) All authenticated users except engineers can list users from their own company.
 * @allow (create) User can create their own profile OR admin/director can create users for their company.
 * @allow (update) User can update their own profile OR admin/director can update users from same company.
 * @allow (delete) User can delete their own profile OR admin/director can delete users from same company.
 * @principle Enforces document ownership for regular users, full control for admin/director within company.
 */
match /users/{userId} {
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }
  
  function getUserData() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  }
  
  function getUserRole() {
    return getUserData().role;
  }
  
  function getUserCompany() {
    return getUserData().companyId;
  }
  
  function isAdminOrDirector() {
    let role = getUserRole();
    return role == 'admin' || role == 'director';
  }
  
  function canListUsers() {
    return isSignedIn() && getUserRole() != 'engineer';
  }
  
  // Check if the target document belongs to same company
  function isSameCompany() {
    return resource.data.companyId == getUserCompany();
  }
  
  // Check if the document being created belongs to same company
  function isCreatingSameCompany() {
    return request.resource.data.companyId == getUserCompany();
  }

  // Get permissions - admin/director can read any user in their company
  allow get: if isOwner(userId) || (isAdminOrDirector() && isSameCompany());
  
  // List permissions - all except engineers can list users from their company
  allow list: if canListUsers() && isSameCompany();
  
  // Create permissions - admin/director can create users for their company
  allow create: if (isSignedIn() && isOwner(userId)) || 
                   (isAdminOrDirector() && isCreatingSameCompany());
  
  // Update permissions - admin/director can update any user in their company
  allow update: if (isSignedIn() && isOwner(userId)) || 
                   (isAdminOrDirector() && isSameCompany());
  
  // Delete permissions - admin/director can delete any user in their company
  allow delete: if (isSignedIn() && isOwner(userId)) || 
                   (isAdminOrDirector() && isSameCompany());
}

    /**
     * @description Manages company data.
     * @path /companies/{companyId}
     * @allow (get) Any signed-in user can read company data.
     * @allow (create) Only admin users can create company data. (Placeholder - Adjust role as needed)
     * @deny (create) Non-admin users cannot create company data.
     * @deny (update) Non-admin users cannot update company data.
     * @principle Restricts write access to authorized roles.
     */
    match /companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder: Anyone signed in can create/update/delete.  Remove these to lock down.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Manages project data.
     * @path /projects/{projectId}
     * @allow (get) Any signed-in user can read project data.
     * @allow (create) Only admin users can create project data. (Placeholder - Adjust role as needed)
     * @deny (create) Non-admin users cannot create project data.
     * @deny (update) Non-admin users cannot update project data.
     * @principle Restricts write access to authorized roles.
     */
    match /projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder: Anyone signed in can create/update/delete.  Remove these to lock down.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Manages payment claim data.
     * @path /claims/{claimId}
     * @allow (get) Any signed-in user can read claim data.
     * @allow (create) Only users with the 'accountant' role can create claims. (Placeholder - Adjust role as needed)
     * @deny (create) Non-accountant users cannot create claim data.
     * @deny (update) Non-accountant users cannot update claim data.
     * @principle Restricts write access to authorized roles.
     */
    match /claims/{claimId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder: Anyone signed in can create/update/delete.  Remove these to lock down.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Manages task data within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (create) Only users who are members of the project can create tasks. (Placeholder - Adjust role as needed)
     * @allow (get) Any signed-in user can read task data.
     * @deny (create) Non-project members cannot create tasks.
     * @deny (update) Non-project members cannot update tasks.
     * @principle Restricts write access to project members.
     */
    match /projects/{projectId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder: Anyone signed in can create/update/delete.  Remove these to lock down.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Manages document data within a project, based on access role.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get) Users with the required 'accessRole' can read documents.
     * @allow (create) Only admin users can create document data. (Placeholder - Adjust role as needed)
     * @deny (create) Non-admin users cannot create document data.
     * @deny (update) Non-admin users cannot update document data.
     * @principle Restricts read and write access based on role.
     */
    match /projects/{projectId}/documents/{documentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder: Anyone signed in can create/update/delete.  Remove these to lock down.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}