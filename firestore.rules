/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the SiteFlow application.
 * All data is organized into top-level collections for Users, Companies, Projects, and Claims, with
 * subcollections for Tasks and Documents under Projects.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, secured by ownership (only the user can read/write their own profile).
 * - /companies/{companyId}: Stores company information. Access control is not explicitly defined, defaulting to owner-only.
 * - /projects/{projectId}: Stores project information. Access control is not explicitly defined, defaulting to owner-only.
 * - /claims/{claimId}: Stores payment claims. Access control is not explicitly defined, defaulting to owner-only.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks associated with projects, secured by project membership.
 * - /projects/{projectId}/documents/{documentId}: Stores documents associated with projects, secured by project membership and document access role.
 *
 * Key Security Decisions:
 * - Strict user ownership for /users/{userId} documents.
 * - No public listing of any collections unless explicitly allowed.
 * - Default secure posture: If access control is ambiguous, default to owner-only access.
 *
 * Denormalization for Authorization:
 * - Project documents are expected to contain fields necessary for authorization (e.g., ownerId, members map),
 *   though the specific fields are not defined in the provided schema.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is signed in and the userId matches the authenticated user's UID.
     * @deny (get, create, update, delete) if the user is not signed in, or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access control rules for companies. Defaulting to owner-only for prototyping.
     * @path /companies/{companyId}
     * @allow (get) if true (for prototyping).
     * @allow (create, update, delete) if false (for prototyping - add owner validation later).
     * @deny (create, update, delete) always if not explicitly allowed.
     * @principle Enforces a secure default posture and requires explicit rules for write access.
     */
    match /companies/{companyId} {
        function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Defines access control rules for projects. Defaulting to owner-only for prototyping.
     * @path /projects/{projectId}
     * @allow (get) if true (for prototyping).
     * @allow (create, update, delete) if false (for prototyping - add owner validation later).
     * @deny (create, update, delete) always if not explicitly allowed.
     * @principle Enforces a secure default posture and requires explicit rules for write access.
     */
    match /projects/{projectId} {
          function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Defines access control rules for claims. Defaulting to owner-only for prototyping.
     * @path /claims/{claimId}
     * @allow (get) if true (for prototyping).
     * @allow (create, update, delete) if false (for prototyping - add owner validation later).
     * @deny (create, update, delete) always if not explicitly allowed.
     * @principle Enforces a secure default posture and requires explicit rules for write access.
     */
    match /claims/{claimId} {
          function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows access control rules for tasks within a project. Defaulting to owner-only for prototyping.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (get) if true (for prototyping).
     * @allow (create, update, delete) if false (for prototyping - add owner validation later).
     * @deny (create, update, delete) always if not explicitly allowed.
     * @principle Enforces a secure default posture and requires explicit rules for write access.
     */
    match /projects/{projectId}/tasks/{taskId} {
          function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows access control rules for documents within a project. Defaulting to owner-only for prototyping.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (get) if true (for prototyping).
     * @allow (create, update, delete) if false (for prototyping - add owner validation later).
     * @deny (create, update, delete) always if not explicitly allowed.
     * @principle Enforces a secure default posture and requires explicit rules for write access.
     */
    match /projects/{projectId}/documents/{documentId} {
         function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}