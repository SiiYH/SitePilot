/**
 * @file Firebase Security Rules for SiteFlow application.
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user data,
 *  and creator-based ownership for projects and claims. Listing of users is denied.
 *  Documents and tasks are secured under their parent project.
 *
 * @data_structure
 * - /users/{userId}: Stores individual user profiles, secured by owner-only access.
 * - /companies/{companyId}: Stores company profiles. Write access is not defined.
 * - /projects/{projectId}: Stores project data, with creator-based ownership.
 * - /claims/{claimId}: Stores payment claims, linked to projects and companies, with creator-based ownership.
 * - /projects/{projectId}/tasks/{taskId}: Stores tasks associated with projects, inherit project ownership.
 * - /projects/{projectId}/documents/{documentId}: Stores documents associated with projects, inherit project ownership.
 *
 * @key_security_decisions
 * - Listing of all users is explicitly denied for security and privacy reasons.
 * - Company data has no defined write rules, assuming administrative management outside of these rules.
 * - Public read access is NOT granted to any collections.
 *
 * @denormalization_for_authorization N/A
 *
 * @structural_segregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete) - Authenticated user can access their own profile if the userId matches their auth.uid.
     * @deny (create) - If the userId does not match the authenticated user's UID.
     * @deny (get, update, delete) - If the userId does not match the authenticated user's UID.
     * @deny (list) - Prevents listing all users.
     * @principle Enforces user-ownership for profiles, preventing unauthorized access or modification.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdminOrDirector());
      allow list: if isSignedIn() && !isEngineer(); // optional: prevent engineers from listing all users
      allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAdminOrDirector());
    }
    
    match /users/{subcollection=**} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdminOrDirector());
      allow list: if isSignedIn() && !isEngineer(); // optional: prevent engineers from listing all users
      allow create, update, delete: if isSignedIn() && (isOwner(userId) || isAdminOrDirector());
    }
    
    // === Licenses rules ===
    match /licenses/{licenseId} {
      allow get, list, create, update: if isSignedIn() && isSuperSystemAdmin();
    }

    // Optional: helper for nested collections (if any)
    match /licenses/{licenseId}/{subcollection=**} {
      allow read, write: if isSignedIn() && isSuperSystemAdmin();
    }

    /**
     * @description Controls access to company profiles.
     * @path /companies/{companyId}
     * @allow (get, list) - Anyone can view company profiles.
     * @deny (create, update, delete) - No one can create, update, or delete company profiles via client-side rules.
     * @principle Restricts write access to company profiles.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isAdminOrDirector();
    }

    /**
     * @description Controls access to project data.
     * @path /projects/{projectId}
     * @allow (create) - Authenticated user can create a project. creatorId must match auth.uid.
     * @allow (get, list) - Anyone can view projects.
     * @allow (update, delete) - Only the project creator can update or delete.
     * @deny (create) - If the creatorId does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the project creator.
     * @principle Enforces creator-based ownership for projects.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.createdBy);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.createdBy);
    }

    /**
     * @description Controls access to payment claims.
     * @path /claims/{claimId}
     * @allow (create) - Authenticated user can create a claim. submittedBy must match auth.uid.
     * @allow (get, list) - Anyone can view claims.
     * @allow (update, delete) - Only the claim submitter can update or delete.
     * @deny (create) - If the submittedBy does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the claim submitter.
     * @principle Enforces submitter-based ownership for claims.
     */
    match /claims/{claimId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.submittedBy);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.submittedBy);
    }

    /**
     * @description Controls access to tasks within a project.
     * @path /projects/{projectId}/tasks/{taskId}
     * @allow (create) - Authenticated user can create a task within a project.
     * @allow (get, list) - Anyone can view tasks within a project.
     * @allow (update, delete) - Only the project creator can update or delete tasks.
     * @deny (update, delete) - If the user is not the project creator.
     * @principle Inherits project ownership for tasks, restricting task management to the project creator.
     */
    match /projects/{projectId}/tasks/{taskId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isProjectOwner(projectId);
      allow delete: if isSignedIn() && isProjectOwner(projectId);
    }

    /**
     * @description Controls access to documents within a project.
     * @path /projects/{projectId}/documents/{documentId}
     * @allow (create) - Authenticated user can create a document within a project.
     * @allow (get, list) - Anyone can view documents within a project.
     * @allow (update, delete) - Only the project creator can update or delete documents.
     * @deny (update, delete) - If the user is not the project creator.
     * @principle Inherits project ownership for documents, restricting document management to the project creator.
     */
    match /projects/{projectId}/documents/{documentId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isProjectOwner(projectId);
      allow delete: if isSignedIn() && isProjectOwner(projectId);
    }

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    function isProjectOwner(projectId) {
        return get(/databases/$(database)/documents/projects/$(projectId)).data.createdBy == request.auth.uid;
    }

    function getUserData() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  }
  
  function getUserRole() {
    return getUserData().role;
  }
  
  function getUserCompany() {
    return getUserData().companyId;
  }
  
  function isEngineer() {	
  return getUserRole() == 'engineer';
	}
  
  function isAdminOrDirector() {
    let role = getUserRole();
    return role == 'admin' || role == 'director';
  }
  
  function isSuperSystemAdmin(){
  	let role = getUserRole();
    return role == 'system super admin';
  }
  
  function canListUsers() {
    return isSignedIn() && getUserRole() != 'engineer';
  }
  
  // Check if the target document belongs to same company
  function isSameCompany() {
    return resource.data.companyId == getUserCompany();
  }
  
  // Check if the document being created belongs to same company
  function isCreatingSameCompany() {
    return request.resource.data.companyId == getUserCompany();
  }
  }
}