rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Helper Functions ===
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }
    
    function getUserCompany() {
      return getUserData().companyId;
    }
    
    function isEngineer() {
      return getUserRole() == 'engineer';
    }
    
    function isAdminOrDirector() {
      let role = getUserRole();
      return role == 'admin' || role == 'director';
    }
    
    function isDirector() {
      return getUserRole() == 'director';
    }
    
    function isSuperSystemAdmin() {
      let role = getUserRole();
      return role == 'system super admin';
    }
    
    function isSameCompany() {
      return resource.data.companyId == getUserCompany();
    }
    
    function isCreatingSameCompany() {
      return request.resource.data.companyId == getUserCompany();
    }
    
    function isAssignedToProject() {
      return resource.data.assignedEngineers.hasAny([request.auth.uid]);
    }
    
    function canAccessProject() {
      return isSuperSystemAdmin() || 
             isAdminOrDirector() || 
             isAssignedToProject();
    }
    
    function isCompanyActivatedByLicense(uid, licenseId) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid));
      let companyDoc = userDoc != null && userDoc.data.companyId != null
        ? get(/databases/$(database)/documents/companies/$(userDoc.data.companyId))
        : null;

      return userDoc != null &&
             companyDoc != null &&
             isAdminOrDirector() &&
             companyDoc.data.licenseKey == licenseId &&
             companyDoc.data.activated == true;
    }
    
    function isClaimOwner(claimData) {
      return isSignedIn() && request.auth.uid == claimData.submittedBy;
    }

    // === User Rules ===
    match /users/{userId} {
      allow get: if isSignedIn() && (
        isOwner(userId) || 
        isAdminOrDirector() || 
        isSuperSystemAdmin()
      );
      
      allow read: if request.auth != null;
      
      allow list: if isSignedIn() || (
        isAdminOrDirector() || 
        isSuperSystemAdmin() ||
        isEngineer()
      );
      
      // Fixed: Allow new users to create their own profile
      allow create: if isSignedIn() && isOwner(userId);
      
      allow update, delete: if isSignedIn() && (
        isOwner(userId) || 
        (isAdminOrDirector() && isSameCompany()) ||
        isSuperSystemAdmin()
      );
    }

    // === License Rules ===
    match /licenses/{licenseId} {
      allow read: if isSignedIn() && (
        isSuperSystemAdmin() ||
        isCompanyActivatedByLicense(request.auth.uid, licenseId)
      );

      allow write: if isSignedIn() && isSuperSystemAdmin();
    }

    // === Company Rules ===
    match /companies/{companyId} {
      allow get: if isSignedIn() || (
        getUserCompany() == companyId ||
        isAdminOrDirector() ||
        isSuperSystemAdmin()
      );
      
      allow list: if isSignedIn() && (
        isAdminOrDirector() || 
        isSuperSystemAdmin()
      );
      
      allow create: if isSignedIn() && (
        (isAdminOrDirector() || isSuperSystemAdmin())
      );
      
      allow update, delete: if isSignedIn() && (
        (isAdminOrDirector() && getUserCompany() == companyId) ||
        isSuperSystemAdmin()
      );
    }

    // === Project Rules ===
    match /projects/{projectId} {
      allow get: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && (isAdminOrDirector() || isAssignedToProject()))
      );
      
      allow list: if isSignedIn() || (
        isSuperSystemAdmin() ||
        isAdminOrDirector() ||
        isEngineer()
      );
      
      allow create: if isSignedIn() && (
        isCreatingSameCompany() && 
        (isAdminOrDirector() || isSuperSystemAdmin())
      );
      
      allow update: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && isAdminOrDirector()) ||
        resource.data.createdBy == request.auth.uid
      );
      
      allow delete: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (isSameCompany() && isAdminOrDirector()) ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // === Claims Rules ===
    match /claims/{claimId} {
      allow get: if isSignedIn() && 
        (isSameCompany() && (resource.data.submittedBy == request.auth.uid || isDirector()));
      
      allow read: if isSignedIn() && (
        isClaimOwner(resource.data) || 
        isDirector()
      );
      
      // Fixed: Removed dangerous "allow list: if true"
      allow list: if isSignedIn() || (
        isSuperSystemAdmin() ||
        isAdminOrDirector() ||
        isEngineer()
      );
      
      allow create: if isSignedIn() && 
                       isCreatingSameCompany() &&
                       request.resource.data.submittedBy == request.auth.uid;
      
      allow update: if isSignedIn() && 
                       isSameCompany() &&
                       (resource.data.submittedBy == request.auth.uid || isDirector());
      
      allow delete: if request.auth != null;
      // if isSignedIn() && 
      //                  isSameCompany() &&
      //                  (resource.data.submittedBy == request.auth.uid || isDirector());
    }

    // === Task Rules ===
    match /projects/{projectId}/tasks/{taskId} {
      function getProject() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function canAccessParentProject() {
        let project = getProject();
        return project.companyId == getUserCompany() &&
               (isAdminOrDirector() || project.assignedEngineers.hasAny([request.auth.uid]));
      }

      function isTaskOwnerOrContributor() {
        return resource.data.owner == request.auth.uid ||
               (resource.data.contributors != null &&
                resource.data.contributors.hasAny([request.auth.uid]));
      }

      // ✅ Read permissions
      // Admin/Director can see all company tasks
      // Engineer can only see if assigned to that project
      allow get, read, list: if isSignedIn() && canAccessParentProject();

      // ✅ Create permissions
      // Admin/Director can create any task under company project
      // Engineer can create if assigned to project
      allow create: if isSignedIn() && canAccessParentProject();

      // ✅ Update permissions
      // Admin/Director can always edit
      // Engineer can edit only their own or contributor tasks within assigned project
      allow update: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (canAccessParentProject() && (isAdminOrDirector() || isTaskOwnerOrContributor()))
      );

      // ✅ Delete permissions
      // Only Admin/Director (or system admin) can delete
      allow delete: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (canAccessParentProject() && isAdminOrDirector())
      );
    }


    // === Document Rules ===
    match /projects/{projectId}/documents/{documentId} {
      function getProject() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }
      
      function canAccessParentProject() {
        let project = getProject();
        return project.companyId == getUserCompany() && (
          isAdminOrDirector() ||
          project.assignedEngineers.hasAny([request.auth.uid])
        );
      }
      
      allow get, list: if isSignedIn() && (
        isSuperSystemAdmin() ||
        canAccessParentProject()
      );
      
      allow create: if isSignedIn() && (
        isSuperSystemAdmin() ||
        canAccessParentProject()
      );
      
      allow update, delete: if isSignedIn() && (
        isSuperSystemAdmin() ||
        (canAccessParentProject() && isAdminOrDirector())
      );
    }
  }
}